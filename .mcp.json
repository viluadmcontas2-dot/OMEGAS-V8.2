{
  "mcpServers": {
    "codex": {
      "type": "stdio",
      "command": "/opt/codex-mcp/bin/codex",
      "args": ["mcp-server"]
    },
    "rea": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "rea-agents@6.4.0", "mcp"],
      "env": {
        "REA_JADX_MCP_JAR": "/root/.omegas-rea/jadx-headless-mcp-0.7.1-all.jar",
        "GHIDRA_INSTALL_DIR": "/root/.omegas-rea/ghidra_12.1.4_PUBLIC",
        "REA_BROWSER_NO_SANDBOX": "1"
      }
    }
  }
}
